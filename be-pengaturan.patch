diff --git a/src/SmartSchool.Infrastructure/Services/Settings/SettingsService.cs b/src/SmartSchool.Infrastructure/Services/Settings/SettingsService.cs
new file mode 100644
index 0000000..f4a27c4
--- /dev/null
